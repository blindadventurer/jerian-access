<Project Sdk="Microsoft.NET.Sdk">

  <!-- The reloadable MODULE: all feature code (input, screens, graph navigator, localization,
       announcements). Day-to-day work goes here - it hot-reloads via POST /reload or F6 with the
       game running. The host reads this dll's BYTES (never loads from path), so the deploy copy
       below succeeds while the game runs. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Unique ASSEMBLY NAME per Debug build: this Mono (Unity 2018) dedupes Assembly.Load(byte[])
         by simple assembly name and returns the already-loaded image - a hot reload with a fixed
         name silently re-executes OLD code (verified live 2026-07-18; a differing version/MVID does
         not help). The deployed FILE name stays JerianAccess.Module.dll (see DeployModule); only
         the internal identity varies. The REPL collapses these generations to the newest
         (CSharpEvaluator). -->
    <AssemblyName>JerianAccess.Module</AssemblyName>
    <AssemblyName Condition="'$(Configuration)' == 'Debug'">JerianAccess.Module.g$([System.DateTime]::UtcNow.ToString(yyyyMMddHHmmss))</AssemblyName>
    <RootNamespace>JerianAccess.Module</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <GameDir>F:\games\The Life and Suffering of Prince Jerian</GameDir>
    <ManagedDir>$(GameDir)\The Life and Suffering of Prince Jerian_Data\Managed</ManagedDir>
    <BepInExCoreDir>$(GameDir)\BepInEx\core</BepInExCoreDir>
    <ModuleDeployDir>$(GameDir)\BepInEx\plugins\JerianAccess\module</ModuleDeployDir>
  </PropertyGroup>

  <!-- TODO(J): Brante game-facing code that does not compile against Jerian's assemblies yet
       (ROADMAP Phase 2-4). Excluded so the infrastructure compiles and the dev server comes up;
       remove entries one by one as each surface is re-pointed at Jerian's types (the Brante
       implementation stays on disk as the porting reference). This list is exactly the files
       that FAIL to compile - everything else carries over. -->
  <ItemGroup>
    <BrokenOnJerian Include="Game\Readouts.cs" />
    <BrokenOnJerian Include="Patches\GameInputPatches.cs" />
    <BrokenOnJerian Include="Patches\SubtitleSpeechPatches.cs" />
    <BrokenOnJerian Include="Screens\CreditsScreen.cs" />
    <BrokenOnJerian Include="Screens\GenericPopupScreen.cs" />
    <BrokenOnJerian Include="Screens\MapWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\TriggerScenePopupScreen.cs" />
    <BrokenOnJerian Include="Screens\MainMenuScreen.cs" />
    <BrokenOnJerian Include="Screens\PauseScreen.cs" />
    <BrokenOnJerian Include="Screens\WindowShellScreen.cs" />
    <BrokenOnJerian Include="Screens\CaseForYearScreen.cs" />
    <BrokenOnJerian Include="Screens\CaseOfYearPopupScreen.cs" />
    <BrokenOnJerian Include="Screens\ChapterFinalScreen.cs" />
    <BrokenOnJerian Include="Screens\ChapterPictureScreen.cs" />
    <BrokenOnJerian Include="Screens\ChapterSelectScreen.cs" />
    <BrokenOnJerian Include="Screens\ChapterStartScreen.cs" />
    <BrokenOnJerian Include="Screens\CharacterInfoScreen.cs" />
    <BrokenOnJerian Include="Screens\CharacterWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\ConfirmPopupScreen.cs" />
    <BrokenOnJerian Include="Screens\DeathScreen.cs" />
    <BrokenOnJerian Include="Screens\DestinyWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\DisclaimerScreen.cs" />
    <BrokenOnJerian Include="Screens\EmpireWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\FamilyWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\HomeWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\InsurrectionSidePopupScreen.cs" />
    <BrokenOnJerian Include="Screens\InsurrectionWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\InterludeScreen.cs" />
    <BrokenOnJerian Include="Screens\LiveTimelineScreen.cs" />
    <BrokenOnJerian Include="Screens\LoadWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\NameRequestScreen.cs" />
    <BrokenOnJerian Include="Screens\ParameterRows.cs" />
    <BrokenOnJerian Include="Screens\RelationsWindowScreen.cs" />
    <BrokenOnJerian Include="Screens\SceneScreen.cs" />
    <BrokenOnJerian Include="Screens\SettingsScreen.cs" />
    <BrokenOnJerian Include="Screens\WorkWindowScreen.cs" />
    <BrokenOnJerian Include="UI\HudBar.cs" />
    <BrokenOnJerian Include="UI\PanelSweep.cs" />
    <Compile Remove="@(BrokenOnJerian)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JerianAccess.Core\JerianAccess.Core.csproj"><Private>false</Private></ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <!-- Game assemblies. On Jerian, I2.Loc lives in Assembly-CSharp-firstpass. -->
    <Reference Include="Assembly-CSharp"><HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputModule"><HintPath>$(ManagedDir)\UnityEngine.InputModule.dll</HintPath><Private>false</Private></Reference>
    <!-- Unity 2020: the legacy Input class (Input.GetKey etc.) lives in InputLegacyModule. -->
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AudioModule"><HintPath>$(ManagedDir)\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Deploy the module beside the host under module/. Safe with the game running: the host never
       file-locks this dll. -->
  <Target Name="DeployModule" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="$(ModuleDeployDir)" />
    <!-- Fixed destination file name regardless of the per-build assembly name: the host watches
         one path. Portable pdbs are matched by embedded GUID, so the rename is harmless. -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFiles="$(ModuleDeployDir)\JerianAccess.Module.dll" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFiles="$(ModuleDeployDir)\JerianAccess.Module.pdb" />
    <!-- Every build has a new output name, so old generations pile up in bin - sweep them. -->
    <ItemGroup>
      <StaleGen Include="$(OutputPath)JerianAccess.Module.g*.dll;$(OutputPath)JerianAccess.Module.g*.pdb"
                Exclude="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb" />
    </ItemGroup>
    <Delete Files="@(StaleGen)" />
    <!-- Locale manifest: the MODULE reads lang/ fresh on every load, so lang edits must deploy
         with module builds (the host csproj also copies it, for host-only builds). -->
    <ItemGroup>
      <ModLang Include="$(MSBuildProjectDirectory)\..\..\lang\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ModLang)" DestinationFiles="@(ModLang->'$(GameDir)\BepInEx\plugins\JerianAccess\lang\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Message Text="Deployed $(AssemblyName) to $(ModuleDeployDir)\JerianAccess.Module.dll" Importance="high" />
  </Target>

</Project>
